{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 30s
			# Envoi d'une partie (~10 à 60 Mo) depuis un réseau mobile lent.
			read_body 15m
		}
	}
}

# En-têtes de sécurité communs ; caméra, micro et géolocalisation limités à ce site.
(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
	}
}

# Vérification du mot de passe de la page capture (le secret ne passe jamais dans l'URL).
# 204 si le Bearer correspond, 401 sinon (y compris si CAPTURE_TOKEN est vide).
(capture_auth) {
	handle /capture-auth {
		header Cache-Control "no-store"
		@authorized expression `"{$CAPTURE_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$CAPTURE_TOKEN}"`
		handle @authorized {
			respond 204
		}
		handle {
			respond "Mot de passe invalide" 401
		}
	}
}

# Upload des parties vidéo et GPS : uniquement Authorization: Bearer <CAPTURE_TOKEN>.
# Fail closed : si CAPTURE_TOKEN est vide, tout est refusé. Le service api n'est pas
# publié sur l'hôte : seul Caddy l'atteint, après cette vérification.
(upload_api) {
	handle /api/upload/* {
		header Cache-Control "no-store"
		@authorized expression `"{$CAPTURE_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$CAPTURE_TOKEN}"`
		handle @authorized {
			request_body {
				max_size 256MB
			}
			reverse_proxy {$API_UPSTREAM:api:8000} {
				transport http {
					dial_timeout 10s
					response_header_timeout 15m
					write_timeout 15m
				}
			}
		}
		handle {
			respond "Authentification requise" 401
		}
	}
}

# Page capture : fichiers statiques publics (l'interface est verrouillée côté JS,
# la vraie protection est /api/upload/* et /capture-auth).
(capture_pages) {
	redir /capture /capture/ 308
	handle_path /capture/* {
		header Cache-Control "no-cache"
		root * {$WEB_DIR:/srv}/capture
		file_server
	}
}

# Administration : jeton séparé de CAPTURE_TOKEN.
(admin_auth) {
	handle /admin-auth {
		header Cache-Control "no-store"
		@authorized expression `"{$ADMIN_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$ADMIN_TOKEN}"`
		handle @authorized {
			respond 204
		}
		handle {
			respond "Jeton administrateur invalide" 401
		}
	}
}

(admin_api) {
	handle /admin/api/* {
		uri strip_prefix /admin
		reverse_proxy {$ADMIN_UPSTREAM:admin:8080}
	}
}

(admin_pages) {
	redir /admin /admin/ 308
	handle_path /admin/* {
		header Cache-Control "no-cache"
		root * {$WEB_DIR:/srv}/admin
		file_server
	}
}

# Téléchargements admin (brut + flouté) avec Bearer ADMIN_TOKEN.
(storage_download) {
	handle /storage-download/raw/* {
		header Cache-Control "no-store"
		@authorized expression `"{$ADMIN_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$ADMIN_TOKEN}"`
		handle @authorized {
			uri strip_prefix /storage-download/raw
			root * {$STORAGE_DIR:/storage}/raw
			file_server
		}
		handle {
			respond "Authentification requise" 401
		}
	}
	handle /storage-download/blurred/* {
		header Cache-Control "no-store"
		@authorized expression `"{$ADMIN_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$ADMIN_TOKEN}"`
		handle @authorized {
			uri strip_prefix /storage-download/blurred
			root * {$STORAGE_DIR:/storage}/blurred
			file_server
		}
		handle {
			respond "Authentification requise" 401
		}
	}
}

# Page publique : vidéos FLOUTÉES uniquement, triées par horodatage. Désactivable avec
# PUBLIC_PAGE_ENABLED=false. Le brut et le GPS JSON ne sont jamais montés sur ces chemins.
# /media/* sert des MP4 progressifs (Range géré par file_server).
(public_site) {
	@public_on expression `"{$PUBLIC_PAGE_ENABLED:true}" == "true"`
	handle @public_on {
		header X-Robots-Tag "noindex, nofollow"
		handle /api/public/* {
			header Cache-Control "no-store"
			reverse_proxy {$API_UPSTREAM:api:8000}
		}
		handle_path /media/* {
			header Cache-Control "public, max-age=3600"
			root * {$STORAGE_DIR:/storage}/blurred
			file_server
		}
		redir /videos /videos/ 308
		handle_path /videos/* {
			header Cache-Control "no-cache"
			root * {$WEB_DIR:/srv}/public
			file_server
		}
		handle / {
			header Cache-Control "no-cache"
			rewrite * /index.html
			root * {$WEB_DIR:/srv}/public
			file_server
		}
		handle {
			respond "Introuvable" 404
		}
	}
	handle /api/public/* {
		respond "Page publique désactivée" 404
	}
	handle /media/* {
		respond "Page publique désactivée" 404
	}
	handle / {
		header X-Robots-Tag "noindex, nofollow"
		respond "Page publique désactivée." 404
	}
}

# Tout chemin non prévu : 404 (sinon Caddy répond 200 avec un corps vide).
(fallback_404) {
	handle {
		respond "Introuvable" 404
	}
}

# Développement local uniquement : HTTP sur http://localhost (Host: localhost).
# Volontairement limité à "localhost" : en production, l'IP nue du VPS ne sert
# rien en clair (le jeton ne doit jamais circuler en HTTP).
http://localhost:{$HTTP_PORT:80} {
	import common_headers
	import upload_api
	import capture_auth
	import capture_pages
	import admin_auth
	import admin_api
	import admin_pages
	import storage_download
	import public_site
	import fallback_404
}

# Production : TLS automatique (Let's Encrypt)
{$DOMAIN} {
	import common_headers
	import upload_api
	import capture_auth
	import capture_pages
	import admin_auth
	import admin_api
	import admin_pages
	import storage_download
	import public_site
	import fallback_404
}

# Domaine public (production) — utilisé par Caddy pour Let's Encrypt
DOMAIN=stream.domaine.com
ACME_EMAIL=ops@domaine.com

# URL WHIP vue par l'iPhone (HTTPS obligatoire hors localhost)
# Ex. https://stream.domaine.com/live/whip ou https://<tailscale-host>:8889/live/whip
PUBLIC_WHIP_URL=https://stream.domaine.com/live/whip

# YouTube Live (optionnel — laisser vide pour désactiver le push RTMP)
YOUTUBE_RTMP_URL=
# Ex. rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx

# MediaMTX / blur
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554/live
MEDIAMTX_RTMP_URL=rtmp://mediamtx:1935/blurred
BLUR_CHUNK_SECONDS=30
BLUR_PROCESS_SCALE=640x360

# Domaine public (production) — utilisé par Caddy pour Let's Encrypt.
# Le DNS (enregistrement A) doit pointer directement vers l'IP du VPS (pas de proxy CDN :
# le WebRTC passe par le port 8189, pas par HTTP).
DOMAIN=stream.domaine.com
ACME_EMAIL=ops@domaine.com

# Mot de passe de la page capture ET jeton Bearer WHIP (/live/*). OBLIGATOIRE :
# docker compose refuse de démarrer s'il est vide, et Caddy refuse tout accès s'il est vide.
# Générer une valeur longue et aléatoire (hex) :  openssl rand -hex 32
# Il se saisit dans le formulaire de la page /capture/ ; il ne doit JAMAIS figurer dans une URL.
CAPTURE_TOKEN=

# YouTube Live (optionnel — laisser vide pour désactiver le push RTMP)
YOUTUBE_RTMP_URL=
# Ex. rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx

# MediaMTX / blur
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554/live
MEDIAMTX_RTMP_URL=rtmp://mediamtx:1935/blurred
# Durée d'un segment flouté : latence du direct public ~ cette durée + temps de calcul.
BLUR_CHUNK_SECONDS=30
# Échelle d'analyse des visages, écrite en paysage ; inversée automatiquement en portrait.
BLUR_PROCESS_SCALE=640x360

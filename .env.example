# Domaine public (production) — utilisé par Caddy pour Let's Encrypt.
# Le DNS (enregistrement A) doit pointer directement vers l'IP du VPS (pas de proxy CDN :
# l'upload de parties de ~10 Mo passe par Caddy en HTTPS).
DOMAIN=stream.domaine.com
ACME_EMAIL=ops@domaine.com

# Mot de passe de la page capture ET jeton Bearer de l'upload (/api/upload/*). OBLIGATOIRE :
# docker compose refuse de démarrer s'il est vide, et Caddy refuse tout accès s'il est vide.
# Générer une valeur longue et aléatoire (hex) :  openssl rand -hex 32
# Il se saisit dans le formulaire de la page /capture/ ; il ne doit JAMAIS figurer dans une URL.
CAPTURE_TOKEN=

# Jeton d'administration (page /admin/, API, téléchargements). Distinct de CAPTURE_TOKEN.
# Générer : openssl rand -hex 32
ADMIN_TOKEN=

# Page publique (/ et /videos/) : vidéos floutées triées par horodatage, sans mot de passe.
# ATTENTION : le GPS et l'heure sont incrustés dans l'image, donc visibles publiquement.
# Mettre false pour couper la page publique (API et /media/ renvoient alors 404).
PUBLIC_PAGE_ENABLED=true

# --- Upload (service api) ---
# Taille max d'une partie envoyée par le téléphone (Mo). Une partie de 10 s à 8 Mbit/s ~ 10 Mo.
MAX_PART_MB=256
# L'API refuse (HTTP 507) les envois quand l'espace libre passe sous ce seuil (Go).
MIN_FREE_GB=2

# --- Floutage (service blur) ---
# Durée visée des segments floutés publiés (s), coupés sur image clé.
SEGMENT_SECONDS=60
# Échelle d'analyse des visages, écrite en paysage ; inversée automatiquement en portrait
# (480x270 -> 270x480 pour 1080x1920). Plus grand = visages lointains mieux repérés, plus lent.
BLUR_PROCESS_SCALE=480x270
# Segments floutés en parallèle. Sur 4 vCPU : 2 workers avec 2 threads chacun.
BLUR_PROCESSOR_WORKERS=2
OMP_NUM_THREADS=2
ONNXRUNTIME_INTRA_OP_NUM_THREADS=2
ONNXRUNTIME_INTER_OP_NUM_THREADS=1
# Préréglage x264 de la sortie (ultrafast = plus rapide mais fichiers plus gros).
BLUR_X264_PRESET=veryfast
# Assembler un MP4 de session une fois tous les segments floutés.
BLUR_ASSEMBLE_SESSION=true
# Fermeture automatique d'une session sans nouvelle partie depuis N secondes (6 h).
SESSION_AUTOCLOSE_S=21600

# --- Admin ---
# Alerte « disque presque plein » quand l'espace libre passe sous ce pourcentage.
DISK_WARN_FREE_PERCENT=15
